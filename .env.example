# NxtWave Self-Service KYC & Enrollment Platform
# Neon PostgreSQL Database Configuration

# Paste your Neon PostgreSQL connection string below (preferably with connection pooling: -pooler.neon.tech):
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Server
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=nxtwave_kyc_super_secure_jwt_secret_2026

# Document Storage (AWS S3 / Cloudflare R2)
STORAGE_BUCKET_NAME=nxtwave-kyc-documents-private
STORAGE_REGION=ap-south-1

# OCR Provider Configuration (GOOGLE_DOC_AI | AZURE_DOC_INTEL | AWS_TEXTRACT | TESSERACT)
OCR_DEFAULT_PROVIDER=GOOGLE_DOC_AI
